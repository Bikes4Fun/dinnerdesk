# Documentation only: export these variables or configure your process manager.
DATABASE_URL=postgresql://localhost/dinnerdesk
# Integration tests need an explicit local test database.
TEST_DATABASE_URL=postgresql://localhost/dinnerdesk_test
# Require accounts for a shared deployment; local guest mode defaults to false.
AUTH_REQUIRED=1
# Use 1 for HTTPS deployments; use 0 only when developing over local HTTP.
COOKIE_SECURE=0
# Set these when configuring password-reset email.
PUBLIC_URL=http://localhost:8000
RESEND_API_KEY=
MAIL_FROM=
# Optional grocery gallery.
# GROCERY_PHOTO_DIR=/absolute/path/to/grocery-photos

# Both are required for local runs and Railway; assets are kept outside Git.
# DINNERDESK_CATALOG_DIR=/private-assets/data
# FOOD_DIR=/private-assets/food

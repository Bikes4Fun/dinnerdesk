{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "node": "22"
  },
  "steps": {
    "build": {
      "commands": [
        "...",
        "npm ci --prefix web",
        "npm run build --prefix web"
      ]
    }
  },
  "deploy": {
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"
  }
}
